[Unit]
Description=MarketEdgePros isolated demo Redis
After=network.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/marketedgepros-demo/redis.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marketedgepros-demo/redis
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=256M
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
